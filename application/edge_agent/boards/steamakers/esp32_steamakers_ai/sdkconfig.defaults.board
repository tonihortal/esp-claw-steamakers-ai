CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# ESP32-S3-WROOM-1-N16R8: 16 MB QIO flash at 80 MHz.
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_16MB.csv"

# The microSD socket remains physically wired to GPIO35-37 but is unused and
# must stay empty. Enable the module's 8 MB octal PSRAM conservatively at
# 40 MHz to tolerate the unterminated traces leading to the empty socket.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_40M=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

# Preserve the agent and hardware APIs while using internal flash for writable
# data. The LCD remains initialized by Board Manager and the system UI stays on.
CONFIG_APP_CLAW_MEMORY_MODE_FULL=n
CONFIG_APP_CLAW_MEMORY_MODE_LIGHTWEIGHT=y
CONFIG_APP_CLAW_SYSTEM_UI_ENABLE=y
CONFIG_APP_CLAW_SYSTEM_UI_BUFFER_LINES=8
CONFIG_APP_CLAW_SYSTEM_UI_STATUS_ONLY=y
CONFIG_APP_CLAW_SYSTEM_UI_HOME_TITLE="ESP-CLAW"
CONFIG_APP_CLAW_SYSTEM_UI_HOME_SUBTITLE="ESP32 STEAMakers AI"
CONFIG_DISPLAY_SERVICE_TASK_STACK_SIZE=8192
CONFIG_APP_CLAW_ENABLE_CLI=y
CONFIG_APP_CLAW_CLI_TASK_STACK_SIZE=6144
CONFIG_APP_CLAW_SCHEDULER_MAX_ITEMS=4
CONFIG_APP_CLAW_CLI_TASK_STACK_SIZE=6144
CONFIG_APP_CLAW_EVENT_ROUTER_TASK_STACK_SIZE=12288
CONFIG_APP_CLAW_SCHEDULER_TASK_STACK_SIZE=6144
CONFIG_APP_CLAW_CORE_TASK_STACK_SIZE=16384
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CA_CERT=y
CONFIG_WIFI_MANAGER_FORCE_CLOSE_AP_ON_STA=y

# Keep local/Web and Telegram support. Other optional integrations remain
# disabled until the PSRAM profile has passed its physical stability test.
CONFIG_APP_CLAW_CAP_IM_QQ=n
CONFIG_APP_CLAW_CAP_IM_FEISHU=n
CONFIG_APP_CLAW_CAP_IM_TG=y
CONFIG_APP_CLAW_IM_TG_INBOUND_ATTACHMENTS=y
CONFIG_APP_CLAW_IM_TG_POLL_TASK_STACK_SIZE=6144
CONFIG_APP_CLAW_CAP_IM_WECHAT=n
CONFIG_APP_CLAW_CAP_MCP_CLIENT=n
CONFIG_APP_CLAW_CAP_MCP_SERVER=n
CONFIG_APP_CLAW_CAP_AGENT_MGR=n

# Keep only the Lua surface used by this board and its integrated hardware
# test: audio, board manager, delay, display, storage and system.  The raw
# peripheral drivers and UI/media helpers below are not needed for the fixed
# onboard wiring and otherwise consume registration and static runtime memory.
CONFIG_APP_CLAW_LUA_DRIVER_ADC=y
CONFIG_APP_CLAW_LUA_DRIVER_GPIO=y
CONFIG_APP_CLAW_LUA_DRIVER_I2C=n
CONFIG_APP_CLAW_LUA_DRIVER_MCPWM=y
CONFIG_APP_CLAW_LUA_DRIVER_PCNT=n
CONFIG_APP_CLAW_LUA_DRIVER_RMT=n
CONFIG_APP_CLAW_LUA_DRIVER_TOUCH=n
CONFIG_APP_CLAW_LUA_DRIVER_UART=n
CONFIG_APP_CLAW_LUA_MODULE_BUTTON=n
CONFIG_APP_CLAW_LUA_MODULE_CAPABILITY=n
CONFIG_APP_CLAW_LUA_MODULE_EVENT_PUBLISHER=n
CONFIG_APP_CLAW_LUA_MODULE_HTTP_SERVER=n
CONFIG_APP_CLAW_LUA_MODULE_JSON=n
CONFIG_APP_CLAW_LUA_MODULE_THREAD=n
CONFIG_APP_CLAW_LUA_MODULE_IMAGE=y
CONFIG_APP_CLAW_LUA_MODULE_LEDC=n
CONFIG_APP_CLAW_LUA_MODULE_LED_STRIP=n
CONFIG_APP_CLAW_LUA_MODULE_LVGL=n
CONFIG_CAP_LUA_TASK_STACK_SIZE=6144
CONFIG_CAP_LUA_OUTPUT_SIZE=1024
CONFIG_CAP_LUA_ASYNC_LOG_DEFAULT_BYTES=1024
CONFIG_CAP_LUA_MAX_JOBS=2
CONFIG_CAP_LUA_MAX_CONCURRENT=1
CONFIG_CAP_LUA_EAGER_MODULE_LOAD=n

# SoftAP provisioning is used on this board; disabling the unused BLE stack
# releases internal RAM that cannot be backed by PSRAM. Keep Wi-Fi queues small
# but sufficient for the configuration portal and agent HTTP traffic.
CONFIG_BT_ENABLED=n
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=8
CONFIG_ESP_WIFI_RX_MGMT_BUF_NUM_DEF=3
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=8

# Board Manager devices used by ESP-Claw.
CONFIG_CODEC_DUMMY_SUPPORT=y
CONFIG_ESP_BOARD_PERIPH_I2S_SUPPORT=y
CONFIG_ESP_BOARD_DEV_AUDIO_CODEC_SUPPORT=y
CONFIG_ESP_BOARD_DEV_DISPLAY_LCD_SUPPORT=y
CONFIG_APP_CLAW_LUA_MODULE_AUDIO=y

# GPIO19/20 are unavailable to native USB when the TFT is connected. Use the
# board's CH340 bridge on UART0 for logs, flashing and the interactive console.
# CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG is not set
CONFIG_ESP_CONSOLE_UART=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
